{
  "name": "trivia-e2e-tests",
  "version": "1.0.0",
  "description": "Playwright E2E tests for trivia web app",
  "private": true,
  "engines": {
    "node": ">=22.9.0",
    "npm": ">=11.17.0"
  },
  "scripts": {
    "test": "cd e2e && playwright test",
    "test:ui": "cd e2e && playwright test --ui",
    "test:headed": "cd e2e && playwright test --headed",
    "test:debug": "cd e2e && playwright test --debug",
    "test:report": "cd e2e && playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^5.3.0"
  }
}
